rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // User profile collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // Subcollection for Bills of Lading saved by the user
      match /bills_of_lading/{billId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(billId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(billId);
      }
    }
  }
}
